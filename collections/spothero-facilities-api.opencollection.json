{
  "opencollection": "1.0.0",
  "info": {
    "name": "SpotHero Parking Availability Facilities API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Facilities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Facility",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.spothero.com/v2/facilities/:facility_id",
            "params": [
              {
                "name": "facility_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the parking facility"
              }
            ]
          },
          "docs": "Retrieve detailed information about a specific parking facility including address, amenities, operating hours, pricing, and directions."
        }
      ]
    }
  ],
  "bundled": true
}