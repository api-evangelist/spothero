          "name": "Search Parking Locations",
          "request": {
            "name": "Search Parking Locations",
            "description": {
              "content": "Search for available parking locations near a given address, coordinates, or point of interest. Returns a list of facilities with availability and pricing for the requested time period.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "latitude",
                  "value": "<float>",
                  "description": "Latitude of the search center point"
                },
                {
                  "disabled": false,
                  "key": "longitude",
                  "value": "<float>",
                  "description": "Longitude of the search center point"
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "Street address or point of interest name to search near"
                },
                {
                  "disabled": false,
                  "key": "starts",
                  "value": "<dateTime>",
                  "description": "(Required) Parking start time in ISO 8601 format"
                },
                {
                  "disabled": false,
                  "key": "ends",
                  "value": "<dateTime>",
                  "description": "(Required) Parking end time in ISO 8601 format"
                },
                {
                  "disabled": false,
                  "key": "radius",
                  "value": "0.5",
                  "description": "Search radius in miles (default 0.5)"
                },
                {
                  "disabled": false,
                  "key": "vehicle_type",
                  "value": "car",
                  "description": "Type of vehicle"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of results to return"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "distance",
                  "description": "Sort order for results"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
