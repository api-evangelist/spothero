                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "object",
                        "properties": {
                          "facility_id": {
                            "type": "string",
                            "description": "SpotHero facility to reserve. Must be the facility_id string returned by search_parking."
                          },
                          "starts": {
                            "type": "string",
                            "description": "Start of the parking reservation as an RFC 3339 datetime with offset, e.g. 2026-06-01T10:00:00-05:00. Must be earlier than ends. Use the offered_starts of the chosen search_parking rate."
                          },
                          "ends": {
                            "type": "string",
                            "description": "End of the parking reservation as an RFC 3339 datetime with offset. Must be in the future and later than starts. Use the offered_ends of the chosen search_parking rate."
                          },
                          "license_plate": {
                            "type": "string",
                            "description": "Vehicle license plate number. Optional, but required for some facilities."
                          },
                          "id": {
                            "type": "string",
                            "description": "Caller-generated identifier for the item being purchased. SpotHero does not issue or resolve this value; it is stored and echoed back on the checkout. Any stable string is acceptable."
                          },
                          "title": {
                            "type": "string",
                            "description": "Human-readable name of the item, e.g. the facility_name from search_parking. Optional; stored and echoed back for display only."
                          },
                          "price": {
                            "type": "integer",
                            "description": "Unit price in the smallest currency unit (cents). Optional; stored and echoed back for display only, as the charged amount comes from totals."
                          }
                        },
                        "required": [
                          "facility_id",
                          "starts",
                          "ends",
                          "id",
                          "title",
                          "price"
                        ],
                        "additionalProperties": false
                      },
                      "id": {
                        "type": "string",
                        "description": "Caller-generated identifier for this line item. SpotHero does not issue or resolve this value; it is stored and echoed back on the checkout. Any stable string is acceptable."
                      },
                      "totals": {
                        "type": [
                          "null",
                          "array"
                        ],
                        "items": {
                          "type": "object",
                          "properties": {
                            "display_text": {
                              "type": "string",
                              "description": "Human-readable label for this line, e.g. 'Service Fee'. Use the matching short_description from search_parking's rates.price_breakdown."
                            },
                            "type": {
                              "type": "string",
                              "description": "Kind of price line. Either 'total' for the authoritative charge, or the type of a single price component copied from search_parking's rates.price_breakdown[].type (e.g. 'rental', 'blanket_fee'). If no 'total' entry is present, all entries are summed and must add up to the rate's total_price."
                            },
                            "amount": {
                              "type": "integer",
                              "description": "Amount in the smallest currency unit (cents for USD/CAD). Must match the corresponding search_parking value_cents exactly; a mismatch at complete_checkout returns a totals_changed error."
                            }
                          },
                          "required": [
                            "type",
                            "amount"
                          ],
                          "additionalProperties": false
                        },
                        "description": "Price lines for this item. At least one entry is required. The resolved amount (the 'total' entry, or the sum of all entries when there is none) must equal the total_price.value_cents of the chosen search_parking rate."
                      },
                      "quantity": {
                        "type": "integer",
                        "description": "Number of units. A parking reservation is always 1."
                      }
                    },
                    "required": [
                      "item",
                      "id",
                      "totals",
                      "quantity"
                    ],
                    "additionalProperties": false
                  },
                  "description": "The items being purchased. Exactly one line item is supported; a checkout covers a single parking reservation."
                }
              },
              "description": "The complete replacement checkout payload. Any field omitted here is dropped from the session.",
              "required": [
                "buyer",
                "context",
                "line_items"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "meta",
            "id",
            "checkout"
          ],
          "additionalProperties": false
        },
        "name": "update_checkout",
        "title": "Update Checkout"
      }
    ]
  }
}
